# =============================================================================
# Content Agent — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================


# -----------------------------------------------------------------------------
# PROVIDER TOGGLE (optional — defaults to "openai")
# Controls which provider is used by Node 5 (text polish + image generation).
#   openai → OpenAI chat completions (gpt-4o) + gpt-image-1-mini
#   gemini → Vertex AI via service account + Gemini image model
# -----------------------------------------------------------------------------
FINAL_OUTPUT_PROVIDER=openai


# -----------------------------------------------------------------------------
# REQUIRED — always needed regardless of provider
# -----------------------------------------------------------------------------

# DeepSeek — used by Node 3 (Drafting) and Node 4 (Reflection)
DEEPSEEK_API_KEY=your_deepseek_key

# OpenAI — used by Node 2 (Research, gpt-5.4) and Node 5 when FINAL_OUTPUT_PROVIDER=openai
OPENAI_API_KEY=your_openai_key

# Supermemory — used by Node 1 (Digital Twin) to fetch your personal memory profile
SUPERMEMORY_API_KEY=your_supermemory_key

# Apify — used by Node 2 (Research) to scrape LinkedIn posts via MCP
APIFY_TOKEN=your_apify_token


# -----------------------------------------------------------------------------
# OPTIONAL — only required when FINAL_OUTPUT_PROVIDER=gemini
# The app will throw a clear error at startup if these are missing when needed.
# -----------------------------------------------------------------------------

# Path to your GCP service account JSON file (Vertex AI auth via ADC)
# GOOGLE_APPLICATION_CREDENTIALS=./gemini_cred.json

# GCP project ID where Vertex AI is enabled
# GOOGLE_PROJECT_ID=your_project_id


# -----------------------------------------------------------------------------
# OPTIONAL — customisation
# -----------------------------------------------------------------------------

# Supermemory container tag — scopes the profile query to your memory space.
# Required by the Supermemory API (omitting it throws a 400 error).
# Find your tag in the Supermemory dashboard under your memory space settings.
# Leave unset to query with an empty string (queries across all containers).
# SUPERMEMORY_CONTAINER_TAG=your_container_tag
